---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';

const title = 'Parroquia San Isidro Labrador | Maimón - Diócesis de La Vega';
const description =
  'Sitio oficial de la Parroquia San Isidro Labrador, Maimón, Provincia Monseñor Nouel, República Dominicana.';
---

<BaseLayout {title} {description}>
  <div class="container">
    <h1><Icon name="fas-cross" /> Parroquia San Isidro Labrador</h1>
    <p>Sitio en migración a Astro + TypeScript.</p>
  </div>
</BaseLayout>

<style>
  h1 {
    display: flex;
    align-items: baseline;
    gap: 0.35em;
    font-family: var(--font-serif);
    color: var(--color-primary-dark);
  }

  h1 :global(svg) {
    font-size: 0.8em;
    color: var(--color-gold-dark);
  }
</style>
