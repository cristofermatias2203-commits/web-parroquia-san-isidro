---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Hero from '../components/Hero.astro';
import QuickStrip from '../components/QuickStrip.astro';
import GospelSection from '../components/GospelSection.astro';
import Schedules from '../components/Schedules.astro';
import Patron from '../components/Patron.astro';
import Sacraments from '../components/Sacraments.astro';
import News from '../components/News.astro';
import Gallery from '../components/Gallery.astro';
import Contact from '../components/Contact.astro';
import Modals from '../components/Modals.astro';
import { site } from '../data/site';
---

<BaseLayout title={site.title} description={site.description}>
  <SiteHeader slot="header" />

  <Hero />
  <QuickStrip />
  <GospelSection />
  <Schedules />
  <Patron />
  <Sacraments />
  <News />
  <Gallery />
  <Contact />

  <fragment slot="footer">
    <Modals />
    <SiteFooter />
  </fragment>
</BaseLayout>
