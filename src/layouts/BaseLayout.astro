---
import Seo from '../components/Seo.astro';
import type { LanguageCode } from '../data/site';
import '../styles/fonts.css';
import '../styles/global.css';
import '../styles/site.css';

interface Props {
  title: string;
  description: string;
  lang?: LanguageCode;
  dir?: 'ltr' | 'rtl';
}

const { title, description, lang = 'es', dir = lang === 'ar' ? 'rtl' : 'ltr' } = Astro.props;
---

<!doctype html>
<html lang={lang === 'zh' ? 'zh-CN' : lang} dir={dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // Idioma y dirección antes del primer pintado: evita el destello del
      // idioma por defecto. El entry client vuelve a aplicarlos con el mismo
      // valor (config.ts comparte la clave de almacenamiento).
      (() => {
        const codes = ['es', 'it', 'en', 'fr', 'de', 'pt', 'pl', 'ar', 'zh'];
        let lang = 'es';
        try {
          const stored = localStorage.getItem('parroquia:idioma');
          if (codes.includes(stored)) {
            lang = stored;
          } else {
            const candidates = navigator.languages?.length
              ? navigator.languages
              : [navigator.language];
            for (const candidate of candidates) {
              const base = String(candidate).toLowerCase().split('-')[0];
              if (codes.includes(base)) {
                lang = base;
                break;
              }
            }
          }
        } catch { /* Almacenamiento o navegador sinidioma */ }
        document.documentElement.lang = lang === 'zh' ? 'zh-CN' : lang;
        document.documentElement.dir = lang === 'ar' ? 'rtl' : 'ltr';
      })();
    </script>
    <Seo {title} {description} {lang} />
    <meta name="theme-color" content="#06466f" />
    <link rel="icon" type="image/png" href="/img/favicon-parroquia.png" />
    <link rel="apple-touch-icon" href="/img/favicon-parroquia.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="preload" href="/fonts/cinzel-latin.woff2" as="font" type="font/woff2" crossorigin />
    <slot name="head" />
  </head>
  <body>
    <a href="#contenido" class="skip-link">Saltar al contenido principal</a>

    <slot name="header" />

    <main id="contenido" tabindex="-1">
      <slot />
    </main>

    <slot name="footer" />

    <script>
      import '../scripts/main';
    </script>
  </body>
</html>
