---
import Icon from './Icon.astro';
---

<section class="hero-vatican" id="inicio">
  <div class="container hero-content">
    <div class="latin-motto" lang="es">SANTA SEDE &bull; COMUNIDAD DE MAIMÓN</div>
    <h2 class="hero-title">Parroquia San Isidro Labrador</h2>
    <p class="hero-subtitle">
      Casa de comunión, altar del sacrificio eucarístico y faro espiritual del pueblo de Maimón.
    </p>

    <div class="hero-divider">
      <span class="line"></span>
      <span class="cross"><Icon name="fas-cross" /></span>
      <span class="line"></span>
    </div>

    <div class="hero-buttons">
      <a href="#horarios" class="btn btn-gold">
        <Icon name="fas-clock" /> Horarios Litúrgicos
      </a>
      <a href="#evangelio" class="btn btn-outline-light">
        <Icon name="fas-scroll" /> Evangelio y Meditación
      </a>
      <a href="#despacho" class="btn btn-outline-light open-modal-intention">
        <Icon name="fas-hands-praying" /> Solicitar Intención
      </a>
    </div>
  </div>
</section>
