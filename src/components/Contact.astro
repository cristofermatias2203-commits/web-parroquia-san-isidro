---
import Icon from './Icon.astro';
import { site } from '../data/site';

const reasons = [
  'Trámite de Bautismo / Boda',
  'Certificado de Fe y Bautismo',
  'Intención de Santa Misa',
  'Inscripción en Catequesis',
  'Cita con el Señor Cura Párroco',
  'Otro asunto eclesial',
];

const mapsUrl =
  'https://www.google.com/maps/search/?api=1&query=Parroquia%20San%20Isidro%20Labrador%20Maim%C3%B3n%20Monse%C3%B1or%20Nouel%20Rep%C3%BAblica%20Dominicana';
---

<section class="section section-bg-ivory" id="despacho">
  <div class="container">
    <div class="contact-section-inner">
      <div class="contact-info-block">
        <span class="section-eyebrow">Curia Paroecialis</span>
        <h3>Despacho & Secretaría Parroquial</h3>
        <p>
          Para solicitud de actas de bautismo, confirmación, intenciones para las Santas Misas y
          atención sacerdotal, estamos a su santa disposición en el centro de Maimón.
        </p>

        <ul class="contact-info-list">
          <li>
            <Icon name="fas-location-dot" />
            <div>
              <strong>Ubicación del Templo y Despacho:</strong><br />
              <a class="contact-link" href={mapsUrl} target="_blank" rel="noopener">
                Calle Principal frente al Parque Central, Maimón, Provincia Monseñor Nouel,
                República Dominicana.
              </a>
            </div>
          </li>
          <li>
            <Icon name="fas-cross" />
            <div>
              <strong>Jurisdicción Canónica:</strong><br />
              Diócesis de La Vega (S.E.R. Obispo Diocesano).
            </div>
          </li>
          <li>
            <Icon name="fas-envelope" />
            <div>
              <strong>Correo Electrónico Parroquial:</strong><br />
              <a class="contact-link" href={`mailto:${site.email}`}>{site.email}</a>
            </div>
          </li>
          <li>
            <Icon name="fas-clock" />
            <div>
              <strong>Horario de Secretaría:</strong><br />
              Lunes a Viernes: 8:30 AM &ndash; 12:00 M y 2:00 PM &ndash; 5:00 PM
            </div>
          </li>
        </ul>
      </div>

      <div class="contact-form">
        <h4 class="contact-form-title">
          <Icon name="fas-feather-pointed" /> Mensaje al Despacho Parroquial
        </h4>

        <div id="formStatus" class="form-status" role="status" aria-live="polite" hidden></div>

        <form id="contactForm">
          <div class="form-group">
            <label for="contactName">Nombre Completo del Feligrés</label>
            <input
              type="text"
              id="contactName"
              name="nombre"
              class="form-control"
              placeholder="Ej. Juan de Jesús Pérez"
              autocomplete="name"
              required
            />
          </div>

          <div class="form-group">
            <label for="contactEmail">Correo Electrónico o Teléfono</label>
            <input
              type="text"
              id="contactEmail"
              name="contacto"
              class="form-control"
              placeholder="Ej. correo@ejemplo.com o 809-xxx-xxxx"
              autocomplete="email"
              required
            />
          </div>

          <div class="form-group">
            <label for="contactReason">Motivo de la Consulta</label>
            <select id="contactReason" name="motivo" class="form-control" required>
              <option value="">Seleccione el asunto...</option>
              {reasons.map((reason) => <option value={reason}>{reason}</option>)}
            </select>
          </div>

          <div class="form-group">
            <label for="contactMessage">Petición o Consulta Detallada</label>
            <textarea
              id="contactMessage"
              name="mensaje"
              class="form-control"
              placeholder="Escriba aquí respetuosamente los pormenores de su solicitud..."
              required
            ></textarea>
          </div>

          <button type="submit" class="btn btn-gold btn-block">
            <Icon name="fas-paper-plane" /> Enviar al Despacho Parroquial
          </button>
          <p class="form-note">
            Al enviar, se abrirá su aplicación de correo con el mensaje preparado para remitirlo al
            despacho parroquial.
          </p>
        </form>
      </div>
    </div>
  </div>
</section>

<style>
  .contact-form-title {
    font-family: var(--font-serif);
    color: var(--color-primary);
    margin-bottom: 14px;
    font-size: 1.3rem;
  }

  .btn-block {
    width: 100%;
    justify-content: center;
  }
</style>
