---
import Icon from './Icon.astro';
---

<section class="section section-bg-ivory" id="evangelio">
  <div class="container">
    <div class="section-header-vatican">
      <span class="section-eyebrow">Verbum Domini</span>
      <h2 class="section-title">Palabra de Dios & Meditación</h2>
      <div class="section-title-ornament">
        <span class="line"></span>
        <Icon name="fas-cross" />
        <span class="line"></span>
      </div>
      <p class="section-subtitle">
        Alimento diario para la vida cristiana en comunión con la Iglesia universal.
      </p>
    </div>

    <div class="gospel-card-wrapper">
      <div class="gospel-header">
        <span class="gospel-liturgical-tag" id="gospelTag">
          <Icon name="fas-book-bible" /> Evangelio del Día
        </span>
        <span class="gospel-date" id="gospelDateFull">
          <Icon name="far-calendar-alt" /> Hoy en el Calendario Litúrgico
        </span>
      </div>

      <div class="gospel-body">
        <div class="gospel-icon"><Icon name="fas-bible" /></div>
        <div
          class="gospel-liturgical-title"
          id="gospelLiturgicalTitle"
        >
          Calendario Litúrgico
        </div>
        <h3 class="gospel-citation" id="gospelCitation">Santo Evangelio del Día</h3>

        <div class="gospel-acclamation" id="gospelAcclamation"></div>
        <div class="gospel-readings" id="gospelReadings"></div>

        <blockquote class="gospel-verse" id="gospelVerse">
          El Evangelio del día se actualiza automáticamente.
        </blockquote>

        <div class="gospel-reflection" id="gospelReflection"></div>
      </div>

      <div class="gospel-footer">
        <button class="btn btn-gold" id="btnTodayGospel">
          <Icon name="fas-sun" /> Evangelio de Hoy
        </button>
        <button class="btn btn-outline-light btn-gospel-next" id="btnNextReading">
          <Icon name="fas-arrows-rotate" /> Próximos Días
        </button>
      </div>

      <p class="gospel-status" id="gospelStatus" role="status" aria-live="polite"></p>
    </div>
  </div>
</section>

<style>
  .gospel-liturgical-title {
    font-family: var(--font-sans);
    font-size: 0.82rem;
    letter-spacing: 0.12em;
    color: var(--color-gold-dark);
    text-transform: uppercase;
    margin-bottom: 6px;
  }

  .gospel-acclamation {
    font-family: var(--font-body);
    font-style: italic;
    font-size: 1.05rem;
    color: var(--color-primary);
    margin-bottom: 18px;
  }

  .gospel-verse {
    text-align: justify;
    font-size: 1.15rem;
    line-height: 1.9;
  }

  .gospel-footer {
    display: flex;
    justify-content: center;
    gap: 12px;
    flex-wrap: wrap;
  }

  .btn-gospel-next {
    color: var(--color-primary);
    border-color: var(--color-border-gold);
    background: #f7fbfe;
  }
</style>
