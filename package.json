{
  "name": "web-parroquia-san-isidro",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Sitio web de la Parroquia San Isidro Labrador de Maimón",
  "scripts": {
    "dev": "bun run build:assets && astro dev",
    "build:assets": "bun run scripts/copy-fonts.mjs && bun run scripts/build-icon-sprite.mjs",
    "build": "bun run build:assets && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "generate:gospel": "node scripts/generate-gospel.mjs"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@fontsource-variable/cinzel": "^5.3.0",
    "@fontsource-variable/cormorant-garamond": "^5.3.0",
    "@fontsource-variable/montserrat": "^5.3.0",
    "@fortawesome/fontawesome-free": "6.4.0",
    "@types/node": "^26.6.6",
    "astro": "^7.4.13",
    "breviarium": "3.1.8",
    "typescript": "^6.0.3"
  }
}
